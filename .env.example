# ==========================================================
# EduAgent
# ==========================================================

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# ==========================================================
# PostgreSQL
# ==========================================================

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=eduagent
POSTGRES_USER=eduagent
POSTGRES_PASSWORD=CHANGE_ME

DATABASE_URL=postgresql+asyncpg://eduagent:CHANGE_ME@127.0.0.1:5432/eduagent

# ==========================================================
# Redis
# ==========================================================

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

# ==========================================================
# MinIO
# ==========================================================

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=eduagent
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET=eduagent

# ==========================================================
# Future Providers
# ==========================================================

OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
